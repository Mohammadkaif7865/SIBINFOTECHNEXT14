# Copy to .env.local and fill in real values. Never commit .env.local.

# Google AI Studio key for Gemini. Used server-side only (pages/api/admin/*).
GEMINI_API_KEY=your_secure_api_key

# Optional: override the Gemini models used. Defaults shown.
GEMINI_MODEL_FLASH=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-pro-latest

# Login password for /admin/trends and /admin/keyword-cannibalization tooling.
ADMIN_PASSWORD=change_me

# Random secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change_me

# Shared secret required by /api/admin/trends/cron/publish-scheduled.
CRON_SECRET=change_me

# Bing IndexNow. The public key below matches public/<key>.txt.
INDEXNOW_KEY=cf0490a9c153417498047e2eff85e0bd
INDEXNOW_ENABLED=false
# Random secret accepted by POST /api/indexnow in the x-indexnow-secret header.
INDEXNOW_SUBMISSION_SECRET=change_me
# Optional Git ref used by the postbuild script to detect changed page routes.
INDEXNOW_BASE_REF=HEAD~1
# Optional comma-separated URLs/paths to submit explicitly during a deployment.
INDEXNOW_URLS=
NEXT_PUBLIC_SITE_URL=https://www.sibinfotech.com

# Optional: existing Claude/Anthropic key used by /admin/keyword-cannibalization
# (Gemini is used automatically as a fallback when this is not set).
ANTHROPIC_API_KEY=
